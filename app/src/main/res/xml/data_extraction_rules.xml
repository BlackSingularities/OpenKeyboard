<?xml version="1.0" encoding="utf-8"?>
<!-- Nic nie trafia do kopii w chmurze ani do przenoszenia między urządzeniami:
     słownik użytkownika, statystyki i schowek zostają na telefonie. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
